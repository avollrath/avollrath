---
import Layout from '../layouts/Layout.astro'
import Sidebar from '../components/Sidebar.astro'
import { formatDate } from '../scripts/utils.js'
import Prose from '../components/Prose.astro'
import FavoriteBooks from '../components/FavoriteBooks.astro'
import Spotify from '../components/Spotify.astro'
import { Image } from 'astro:assets'
import { resolveImage } from '../scripts/resolveImage'

const { frontmatter } = Astro.props

resolveImage(frontmatter)

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString()
const authorName = frontmatter.author || 'Andre Vollrath'
const showFavoriteBooks = frontmatter.showFavoriteBooks === true
const showSpotifyComponent = frontmatter.showSpotifyComponent === true
const articleStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: frontmatter.title,
	description: frontmatter.description,
	datePublished: new Date(frontmatter.pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: authorName
	},
	mainEntityOfPage: canonicalUrl,
	url: canonicalUrl,
	image: frontmatter.image?.src
		? new URL(
				typeof frontmatter.image.src === 'string'
					? frontmatter.image.src
					: frontmatter.image.src.src,
				Astro.site ?? Astro.url
			).toString()
		: undefined
}
---

<Layout
	title={frontmatter.title}
	description={frontmatter.description}
	seo={{
		type: 'article',
		author: authorName,
		publishedTime: frontmatter.pubDate,
		modifiedTime: frontmatter.updatedDate,
		tags: frontmatter.tags ?? [],
		ogImage: frontmatter.image?.src,
		ogImageAlt: frontmatter.image?.alt ?? frontmatter.title,
		siteName: 'Andre Vollrath',
		structuredData: [articleStructuredData]
	}}
>
	<div
		class="border-gradient flex flex-col items-center rounded-lg bg-white px-4 py-12 dark:bg-gradient-to-r sm:px-56 sm:py-24 lg:col-span-9"
	>
		<header class="blog-header text-center">
			<h1 class="long-transition mb-4 font-header leading-snug tracking-wide sm:text-4xl">
				{frontmatter.title}
			</h1>
			<div class="metadata mb-4 flex flex-col">
				<span class="mb-4 text-lg">{formatDate(frontmatter.pubDate)}</span>
				{
					frontmatter.tags && frontmatter.tags.length > 0 && (
						<div class="mt-2 inline-flex flex-wrap justify-center gap-2">
							{frontmatter.tags.map((tag) => (
								<span
									key={tag}
									class="rounded bg-magenta px-2 py-1 text-xs font-semibold text-white lg:text-xs"
								>
									{tag}
								</span>
							))}
						</div>
					)
				}
			</div>
			{
				frontmatter.image?.src ? (
					<Image
						src={frontmatter.image.src}
						alt={frontmatter.image.alt || 'Blog Post Image'}
						class="mb-6 w-full rounded-xl"
						decoding="async"
						loading="eager"
						fetchpriority="high"
					/>
				) : (
					<p>No image available</p>
				)
			}
		</header>
		<article class="blog-content max-w-full text-left text-xl leading-relaxed">
			<Prose>
				<slot />
			</Prose>
		</article>
		{
			showFavoriteBooks && (
				<div class="mt-12 w-full">
					<FavoriteBooks colSpan="" bookWidth="w-20" />
				</div>
			)
		}
		{
			showSpotifyComponent && (
				<div class="mt-12 w-full">
					<Spotify colSpan="" coverWidth="w-20" />
				</div>
			)
		}
	</div>

	<div class="lg:col-span-3">
		<Sidebar />
	</div>
</Layout>
