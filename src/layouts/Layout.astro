---
import NavBar from '../components/NavBar.astro'
import Footer from '../components/Footer.astro'
import { ViewTransitions } from 'astro:transitions'
import '../styles/marquee.css'
import '../styles/main.css'
const { title, description } = Astro.props
import faviconSrc from '../images/favicon.svg'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="icon" href={faviconSrc.src} type="image/svg+xml" />
		<meta name="description" content={description} />
		<script
			data-goatcounter="https://vollrath.goatcounter.com/count"
			async
			src="//gc.zgo.at/count.js"></script>

		<meta property="og:title" content="André Vollrath's tech space" />
		<meta property="og:type" content="website" />

		<ViewTransitions />
		<script is:inline>
			const isHome = window.location.pathname === '/'
			if (isHome && window.__homeIntroSeen !== true) {
				document.documentElement.classList.add('home-intro-pending')
			}
		</script>
		<style is:global>
			html.home-intro-pending .nav-bar,
			html.home-intro-pending .nav-item,
			html.home-intro-pending .nav-logo,
			html.home-intro-pending .hero-container,
			html.home-intro-pending .hero-badge,
			html.home-intro-pending .hero-header,
			html.home-intro-pending .intro-text,
			html.home-intro-pending .cta-button,
			html.home-intro-pending .avatar-wrapper,
			html.home-intro-pending .now-container,
			html.home-intro-pending .now-content,
			html.home-intro-pending .blog-container,
			html.home-intro-pending .blog-content,
			html.home-intro-pending .about-container,
			html.home-intro-pending .about-content,
			html.home-intro-pending .render-container,
			html.home-intro-pending .render-content,
			html.home-intro-pending .spotify-container {
				opacity: 0;
			}
		</style>
	</head>
	<body class="bg-gray-50 font-body text-dark-text dark:bg-dark-bg dark:text-white">
		<div transition:persist class="sticky top-0 z-10 mx-auto max-w-1970 sm:static sm:z-0 sm:px-4 sm:pt-4">
			<NavBar />
		</div>
		<div
			class="container mx-auto flex min-h-screen w-full max-w-1970 flex-col py-1 sm:px-4 sm:py-4"
		>
			<!-- Main content area with 12-column grid layout -->
			<main class="flex-grow">
				<div class="grid grid-cols-1 gap-4 xl:grid-cols-3 2xl:grid-cols-12">
					<slot />
					<!-- Slot for page-specific content -->
				</div>
			</main>
		</div>
		<div transition:persist>
			<Footer />
		</div>
		<script src="../scripts/interactiveSections.js"></script>
		<script>
			import { initializeTooltips } from '../scripts/initializeTooltips.js'
			import { initializeNavigation } from '../scripts/navigationHandler.js'
			import { initGSAP } from '../scripts/gsapHandler.js'

			const init = () => {
				initializeTooltips()
				initGSAP()
			}

			if (!window.__navigationInitialized) {
				initializeNavigation()
				window.__navigationInitialized = true
			}

			if (!window.__layoutPageLoadBound) {
				document.addEventListener('astro:page-load', init)
				window.__layoutPageLoadBound = true
			}
		</script>
	</body>
</html>
