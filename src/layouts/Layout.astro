---
import NavBar from '../components/NavBar.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import { ClientRouter } from 'astro:transitions'
import '../styles/marquee.css'
import '../styles/main.css'
const { title, description, seo = {} } = Astro.props
import faviconSrc from '../images/favicon.svg'
const pathname = Astro.url.pathname
const initialHomeIntro = pathname === '/'
const initialAboutIntro = pathname === '/about' || pathname === '/about/'
const initialProjectsIntro = pathname === '/projects' || pathname === '/projects/'
const initialRenderIntro = pathname === '/renders' || pathname === '/renders/'
---

<!doctype html>
<html
	lang="en"
	class:list={[
		initialHomeIntro && 'home-intro-pending',
		initialAboutIntro && 'about-intro-pending',
		initialProjectsIntro && 'projects-intro-pending',
		initialRenderIntro && 'render-intro-pending'
	]}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href={faviconSrc.src} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
		/>
		<SEO title={title} description={description} {...seo} />
		<script
			data-goatcounter="https://vollrath.goatcounter.com/count"
			async
			src="//gc.zgo.at/count.js"></script>
		<script is:inline>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
			const lowCpu =
				typeof navigator.hardwareConcurrency === 'number' &&
				navigator.hardwareConcurrency > 0 &&
				navigator.hardwareConcurrency <= 4
			const lowMemory =
				typeof navigator.deviceMemory === 'number' &&
				navigator.deviceMemory > 0 &&
				navigator.deviceMemory <= 4
			if (prefersReducedMotion || lowCpu || lowMemory) {
				document.documentElement.classList.add('reduced-motion')
			}
		</script>
		<style is:global>
			html.home-intro-pending .nav-bar,
			html.home-intro-pending .nav-item,
			html.home-intro-pending .nav-logo,
			html.home-intro-pending .hero-container,
			html.home-intro-pending .hero-badge,
			html.home-intro-pending .hero-header,
			html.home-intro-pending .intro-text,
			html.home-intro-pending .cta-button,
			html.home-intro-pending .avatar-wrapper,
			html.home-intro-pending .now-container,
			html.home-intro-pending .now-content,
			html.home-intro-pending .blog-container,
			html.home-intro-pending .blog-content,
			html.home-intro-pending .about-container,
			html.home-intro-pending .about-content,
			html.home-intro-pending .render-container,
			html.home-intro-pending .render-content,
			html.home-intro-pending .client-logos-container,
			html.home-intro-pending .spotify-container {
				opacity: 0;
				visibility: hidden;
			}

			html.about-intro-pending .about-image {
				opacity: 0;
				visibility: hidden;
			}

			html.projects-intro-pending .project-card {
				opacity: 0;
				visibility: hidden;
			}

			html.render-intro-pending .render-text-container,
			html.render-intro-pending .render-image-container {
				opacity: 0;
				visibility: hidden;
			}


		</style>
		<ClientRouter />
	</head>
	<body class="bg-gray-50 font-body text-dark-text dark:bg-dark-bg dark:text-white">
		<div
			transition:persist
			class="sticky top-0 z-[1200] mx-auto max-w-1970 sm:static sm:z-0 sm:px-4 sm:pt-4"
		>
			<NavBar />
		</div>
		<div
			class="container mx-auto flex min-h-screen w-full max-w-1970 flex-col py-1 sm:px-4 sm:py-4"
		>
			<!-- Main content area with 12-column grid layout -->
			<main class="flex-grow">
				<div class="grid grid-cols-1 gap-4 xl:grid-cols-3 2xl:grid-cols-12">
					<slot />
					<!-- Slot for page-specific content -->
				</div>
			</main>
		</div>
		<div transition:persist>
			<Footer />
		</div>
		<script>
			import { initializeNavigation } from '../scripts/navigationHandler.js'
			import { initializeInteractiveSections } from '../scripts/interactiveSections.js'

			const animationModulePromise = import('../scripts/gsapHandler.js')
			const tooltipModulePromise = import('../scripts/initializeTooltips.js')

			const preloadAnimationModule = () => animationModulePromise
			const preloadTooltipModule = () => tooltipModulePromise

			const warmInteractionModules = () => {
				if (window.__transitionWarmupBound) return

				const warmAnimations = (event) => {
					const link = event.target?.closest?.('a[href], .clickable-section')
					if (!link) return

					const href =
						link.getAttribute?.('href') ||
						link.querySelector?.('.arrow-link')?.getAttribute?.('href')

					if (!href || href.startsWith('http') || href.startsWith('mailto:')) return
					preloadAnimationModule().then(({ preloadGSAPForPath }) => {
						preloadGSAPForPath(new URL(href, window.location.href).pathname)
					})
				}

				document.addEventListener('pointerenter', warmAnimations, true)
				document.addEventListener('focusin', warmAnimations)
				window.__transitionWarmupBound = true
			}

			const init = () => {
				const documentElement = document.documentElement
				const reducedMotion = documentElement.classList.contains('reduced-motion')
				const hasPendingIntro =
					documentElement.classList.contains('home-intro-pending') ||
					documentElement.classList.contains('about-intro-pending') ||
					documentElement.classList.contains('projects-intro-pending') ||
					documentElement.classList.contains('render-intro-pending')

				if (!reducedMotion && document.querySelector('[title]')) {
					preloadTooltipModule().then(({ initializeTooltips }) => {
						initializeTooltips()
					})
				}

				const initAnimations = () => {
					preloadAnimationModule().then(({ initGSAP }) => {
						initGSAP()
					})
				}

				if (hasPendingIntro) {
					requestAnimationFrame(() => {
						requestAnimationFrame(initAnimations)
					})
				} else if ('requestIdleCallback' in window) {
					requestIdleCallback(initAnimations, { timeout: 700 })
				} else {
					setTimeout(initAnimations, 0)
				}
			}

			if (!window.__navigationInitialized) {
				initializeNavigation()
				window.__navigationInitialized = true
			}

			initializeInteractiveSections()
			warmInteractionModules()

			if (
				document.documentElement.classList.contains('home-intro-pending') ||
				document.documentElement.classList.contains('about-intro-pending') ||
				document.documentElement.classList.contains('projects-intro-pending') ||
				document.documentElement.classList.contains('render-intro-pending')
			) {
				preloadAnimationModule()
			} else if ('requestIdleCallback' in window) {
				requestIdleCallback(preloadAnimationModule, { timeout: 1800 })
				requestIdleCallback(preloadTooltipModule, { timeout: 1800 })
			} else {
				setTimeout(preloadAnimationModule, 500)
				setTimeout(preloadTooltipModule, 500)
			}

			if (!window.__layoutPageLoadBound) {
				document.addEventListener('astro:page-load', init)
				window.__layoutPageLoadBound = true
			}
		</script>
	</body>
</html>
