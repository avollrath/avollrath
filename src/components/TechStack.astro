---
import { Image } from 'astro:assets'

const { logos: selectedLogos, excludeLogos = [] } = Astro.props

// Fetch all logo images
const allImages = Object.values(import.meta.glob('/src/images/logos/*.svg', { eager: true }))

const getFilename = (src) => {
	// Remove the path and any query parameters
	const filename = src.split('/').pop()?.split('?')[0] ?? ''
	// Only remove the hash pattern (like .BgovzQDw) before .svg
	return filename.replace(/\.[A-Za-z0-9_-]{8}\.svg$/i, '.svg')
}

// Process and format logos
const logos = allImages
	.filter((image) => {
		const filename = getFilename(image.default.src)
		if (Array.isArray(excludeLogos) && excludeLogos.includes(filename)) {
			return false
		}

		if (selectedLogos && Array.isArray(selectedLogos) && selectedLogos.length > 0) {
			return selectedLogos.includes(filename)
		}
		return true
	})
	.map((image) => {
		const filename = getFilename(image.default.src)
		// Now just remove the .svg extension for display
		const formattedName = filename.replace(/\.svg$/i, '').replace(/-/g, ' ')
		return {
			src: image.default,
			title: formattedName
		}
	})
---

<div class="p-4 text-center">
	<div class="flex flex-wrap justify-center gap-6">
		{
			logos.map((logo) => (
				<div class="tech-stack-icon flex flex-col items-center space-y-2" key={logo.title}>
					<Image
						src={logo.src}
						title={logo.title}
						class="tech-stack-logo h-7 w-7 rounded sm:h-10 sm:w-10"
						alt={logo.title}
						loading="lazy"
						decoding="async"
					/>
				</div>
			))
		}
	</div>
</div>

<style>
	.tech-stack-logo {
		transition:
			transform 250ms ease,
			opacity 250ms ease;
	}

	.tech-stack-logo:hover {
		opacity: 1;
		transform: translateY(-2px);
	}
</style>
