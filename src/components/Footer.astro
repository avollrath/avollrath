---
import RunTracker from './RunTracker.astro'
---

<footer
	class="footer-bar z-0 w-full flex-col items-center justify-center divide-y-2 text-center text-sm text-gray-400 sm:text-base"
>
	<button
		type="button"
		class="scroll-top-btn m-auto mx-auto my-8 mb-8 block w-fit cursor-pointer rounded-full border-2 border-solid border-magenta bg-white px-6 py-2 text-center text-base font-semibold text-magenta shadow-lg"
	>
		Scroll to top &uarr;
	</button>
	<div class="bg-gray-100 px-4 pb-32 pt-6 sm:px-8">
		<div class="mb-20">
			<RunTracker />
		</div>
		<p>
			Handmade with ❤️ by <strong class="font-semibold text-dark-text">André Vollrath</strong> &copy;
			2026.
			<br />All rights reserved.
		</p>
	</div>
</footer>
