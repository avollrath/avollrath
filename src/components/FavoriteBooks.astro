---
import favoriteBooks from '../lib/books.json'
import { Image } from 'astro:assets'
import { resolveBookCoverUrl, BOOK_COVER_FALLBACK } from '../scripts/bookCoverUrl.js'
import { getLocalBookCover, placeholderCover } from '../scripts/bookCoverAssets.js'
import { hashStringToSeed, shuffleDeterministic } from '../scripts/deterministicShuffle.js'
const fallbackCover = BOOK_COVER_FALLBACK
const colSpan = Astro.props.colSpan || '2xl:col-span-12' // Default value if colSpan prop is not passed
const bookWidth = Astro.props.bookWidth || 'w-32' // Default width if bookWidth prop is not passed

const buildSeed = import.meta.env.PUBLIC_BUILD_SEED || 'default'
const shuffleSeed = hashStringToSeed(`${Astro.url.pathname}|favorite-books|${buildSeed}`)
const shuffledFavoriteBooks = shuffleDeterministic(favoriteBooks, shuffleSeed)
---

<div
	class={`${colSpan} col-span-3 z-10  bg-white px-4 py-8 2xl:p-12 rounded-md sm:rounded-lg border-gradient flex flex-col items-center shadow-lg`}
>
	<h2
		class="long-transition mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
	>
		Favorite Books
	</h2>
	<div class="flex w-full flex-row flex-wrap justify-center">
		{
			shuffledFavoriteBooks.map((book, index) => {
				const localCover = getLocalBookCover(book)

				return (
					<div key={index} class="p-2 2xl:p-4">
						<div
							class="fav-book-image"
							title={`<strong class='font-semibold'>${book.title}</strong> - ${book.authors}`}
						>
							{localCover ? (
								<Image
									src={localCover}
									alt={`Cover of ${book.title}`}
									class={`${bookWidth} h-auto w-20 rounded shadow-lg transition-transform duration-300 ease-in-out hover:scale-110`}
									loading="lazy"
									width={160}
									format="webp"
								/>
							) : (
								<img
									src={resolveBookCoverUrl(book.coverURL, fallbackCover)}
									alt={`Cover of ${book.title}`}
									class={`${bookWidth} h-auto w-20 rounded shadow-lg transition-transform duration-300 ease-in-out hover:scale-110`}
									loading="lazy"
									decoding="async"
									width="160"
									height="240"
									referrerpolicy="no-referrer"
									onError={(e) => (e.currentTarget.src = placeholderCover.src)}
								/>
							)}
						</div>
					</div>
				)
			})
		}
	</div>
</div>
