---
import {
	createSeededRng,
	hashStringToSeed,
	shuffleDeterministic
} from '../scripts/deterministicShuffle.js'

// Shuffle the array and ensure adjacent items are not both highlighted
function shuffleAndDistribute(words, seed) {
	const shuffledWords = shuffleDeterministic(words, seed)
	const colorRng = createSeededRng(seed ^ 0x9e3779b9)

	// Ensuring no adjacent highlighted items
	for (let i = 0; i < shuffledWords.length - 1; i++) {
		if (i % 2 === 0 && (i + 1) % 2 === 0) {
			let next = i + 2
			if (next < shuffledWords.length) {
				;[shuffledWords[i + 1], shuffledWords[next]] = [shuffledWords[next], shuffledWords[i + 1]]
			}
		}
	}

	// Add color information to each word
	return shuffledWords.map((word, index) => ({
		text: word,
		isHighlighted: index % 2 === 0,
		color: colorRng() < 0.5 ? 'text-magenta' : 'text-dark-text'
	}))
}

const { words } = Astro.props
const buildSeed = import.meta.env.PUBLIC_BUILD_SEED || 'default'
const baseSeed = hashStringToSeed(`${Astro.url.pathname}|marquee|${buildSeed}`)
---

<section
	class="enable-animation long-transition font-header text-5xl uppercase text-gray-300 dark:text-white sm:text-8xl"
>
	{
		Array.from({ length: 5 }).map((_, index) => {
			const processedWords = shuffleAndDistribute(words, baseSeed + index * 97)
			return (
				<div class={`marquee ${index % 2 === 0 ? '' : 'marquee--reverse'}`}>
					<ul class="marquee__content">
						{processedWords.map((word, wordIndex) => (
							<li key={`${index}-${wordIndex}`} class={word.isHighlighted ? word.color : ''}>
								{word.text}
							</li>
						))}
					</ul>
					<ul class="marquee__content">
						{processedWords.map((word, wordIndex) => (
							<li key={`${index}-${wordIndex}`} class={word.isHighlighted ? word.color : ''}>
								{word.text}
							</li>
						))}
					</ul>
				</div>
			)
		})
	}
</section>
