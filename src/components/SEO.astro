---
const {
	title,
	description,
	siteName = 'André Vollrath',
	type = 'website',
	ogImage = '/about2.jpg',
	ogImageAlt = 'André Vollrath portfolio preview',
	twitterCard = 'summary_large_image',
	twitterSite,
	twitterCreator,
	noindex = false,
	canonical,
	author,
	publishedTime,
	modifiedTime,
	tags = [],
	structuredData = []
} = Astro.props

const siteUrl = Astro.site
const pageUrl = Astro.url

const canonicalUrl = canonical
	? new URL(canonical, siteUrl ?? pageUrl).toString()
	: siteUrl
		? new URL(pageUrl.pathname, siteUrl).toString()
		: pageUrl.toString()

const resolvedOgImage = ogImage
	? new URL(typeof ogImage === 'string' ? ogImage : ogImage.src, siteUrl ?? pageUrl).toString()
	: undefined

const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow'
const locale = 'en_US'

const socialLinks = [
	'https://github.com/avollrath',
	'https://www.linkedin.com/in/andrevollrath/',
	'https://www.instagram.com/charliefeatherlight/'
]

function formatPathLabel(segment) {
	if (!segment) return ''
	const decoded = decodeURIComponent(segment)
	if (decoded === 'posts') return 'Blog'
	return decoded
		.replace(/[-_]/g, ' ')
		.replace(/\b\w/g, (char) => char.toUpperCase())
}

const pathSegments = pageUrl.pathname.split('/').filter(Boolean)

const breadcrumbItems = [
	{
		'@type': 'ListItem',
		position: 1,
		name: 'Home',
		item: new URL('/', siteUrl ?? pageUrl).toString()
	},
	...pathSegments.map((segment, index) => ({
		'@type': 'ListItem',
		position: index + 2,
		name: formatPathLabel(segment),
		item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}/`, siteUrl ?? pageUrl).toString()
	}))
]

const defaultStructuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: siteName,
		url: new URL('/', siteUrl ?? pageUrl).toString(),
		inLanguage: 'en'
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'André Vollrath',
		url: new URL('/', siteUrl ?? pageUrl).toString(),
		jobTitle: 'Frontend Developer',
		sameAs: socialLinks
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbItems
	}
]

const mergedStructuredData = [...defaultStructuredData, ...structuredData]
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={author ?? siteName} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:locale" content={locale} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
{resolvedOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
{author && <meta property="article:author" content={author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
{resolvedOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

{
	mergedStructuredData.map((entry) => (
		<script type="application/ld+json" set:html={JSON.stringify(entry)} />
	))
}
