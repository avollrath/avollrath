---
import { Image } from 'astro:assets'
import vollrathLogo from '../images/vollrath_logo.svg'

const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/'

const navItems = [
	{ path: '/', label: 'Home', id: 'home-link' },
	{ path: '/about', label: 'About', id: 'about-link' },
	{ path: '/projects', label: 'Projects', id: 'projects-link' },
	{ path: '/now', label: 'Now', id: 'now-link' },
	{ path: '/renders', label: 'Renders', id: 'renders-link' },
	{ path: '/blog', label: 'Blog', id: 'blog-link', additionalPaths: ['/posts'] }
]

function isPathActive(itemPath, additionalPaths = []) {
	return (
		currentPath === itemPath || additionalPaths.some((addPath) => currentPath.startsWith(addPath))
	)
}
---

<nav
	class="nav-bar border-gradient z-40 flex items-center justify-between bg-white px-4 shadow-lg sm:rounded-lg sm:px-12"
>
	<a href="/" class="z-50">
		<Image
			src={vollrathLogo}
			class="nav-logo mr-2 h-auto w-10 py-2 sm:w-16 sm:py-3"
			alt="Vollrath Logo"
		/>
	</a>

	<!-- Hamburger Menu -->
	<button
		class="z-[1301] flex cursor-pointer flex-col space-y-1 sm:space-y-2 lg:hidden"
		id="hamburger"
		aria-label="Menu"
		aria-expanded="false"
	>
		<span class="block h-0.5 w-5 bg-dark-text transition-all duration-300 sm:w-8"></span>
		<span class="block h-0.5 w-5 bg-dark-text transition-all duration-300 sm:w-8"></span>
		<span class="block h-0.5 w-5 bg-dark-text transition-all duration-300 sm:w-8"></span>
	</button>

	<!-- Navigation Menu -->
	<div
		class="hidden fixed inset-0 z-[1300] flex select-none flex-col items-center justify-center bg-white font-header text-xl lg:relative lg:flex lg:flex-row lg:bg-transparent"
		id="nav-menu"
	>
		<button
			id="menu-close"
			type="button"
			aria-label="Close menu"
			class="absolute right-6 top-6 hidden h-12 w-12 items-center justify-center rounded-full border-2 border-dark-text text-3xl leading-none text-dark-text lg:hidden"
		>
			&times;
		</button>
		{
			navItems.map((item) => (
				<a
					href={item.path}
					class={`nav-item relative px-3 py-2 font-body transition-colors duration-300 lg:py-4 ${
						isPathActive(item.path, item.additionalPaths)
							? 'gradient-underline text-dark-text'
							: 'text-gray-400 hover:text-dark-text'
					}`}
					id={item.id}
				>
					{item.label}
				</a>
			))
		}
		<div id="nav-underline" class="nav-underline invisible lg:visible"></div>
	</div>
</nav>
