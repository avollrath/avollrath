---
import { Image } from 'astro:assets'
import TechStack from '../components/TechStack.astro'

const { project } = Astro.props
const {
	title,
	heroImage,
	heroImageAlt,
	techStackLogos,
	liveUrl,
	iframeSrc,
	iframeLayout,
	buttonText
} = project
---

<article
	class="project-detail-card col-span-3 2xl:col-span-12 rounded-lg bg-white shadow-lg overflow-hidden"
>
	<!-- Header: tech stack + title above the hero -->
	<div class="flex flex-col items-center px-6 pt-8 pb-8 sm:px-10">
		{
			techStackLogos && techStackLogos.length > 0 && (
				<div class="mb-4">
					<TechStack logos={techStackLogos} />
				</div>
			)
		}
		<h1
			class="w-fit rounded-lg border-2 border-solid border-magenta px-6 py-2 font-header text-2xl text-magenta sm:text-3xl"
		>
			{title}
		</h1>
		{
			liveUrl && (
				<a
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-3 text-xs font-semibold text-gray-400 transition hover:text-magenta"
				>
					{liveUrl.replace(/^https?:\/\//, '')}
				</a>
			)
		}
	</div>

	<!-- Hero image -->
	<div
		class={`relative flex justify-center px-6 pb-6 sm:px-10 sm:pb-10 ${iframeSrc ? 'cursor-pointer iframe-trigger' : ''}`}
	>
		<Image
			src={heroImage}
			alt={heroImageAlt}
			class="max-w-full rounded-md border border-gray-200"
			style={`max-width: min(100%, ${heroImage.width}px)`}
			decoding="async"
			loading="eager"
			quality={95}
			width={heroImage.width}
			height={heroImage.height}
		/>
		{
			buttonText && (
				<button class="project-button absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-magenta px-4 py-2 text-xs font-semibold text-white shadow-lg sm:px-6 sm:py-3 sm:text-base lg:px-8 lg:py-4 lg:text-xl">
					{buttonText}
				</button>
			)
		}
	</div>

	{
		iframeSrc && (
			<div
				class={`iframe-container hidden w-full ${iframeLayout === 'drum-machine' ? 'iframe-container--drum-machine' : ''}`}
			>
				<iframe
					class={`w-full ${iframeLayout === 'drum-machine' ? 'drum-machine-iframe' : 'aspect-video'}`}
					title={`${title} interactive demo`}
					data-src={iframeSrc}
					allowfullscreen
					loading="lazy"
				/>
			</div>
		)
	}

	<!-- Content -->
	<div class="p-6 sm:px-56 sm:py-14">
		<div class="prose prose-sm sm:prose-base prose-img max-w-none text-gray-500 prose-headings:text-dark-text prose-strong:text-dark-text prose-a:text-magenta prose-a:underline prose-a:font-semibold hover:prose-a:opacity-80">
			<slot />
		</div>
	</div>
</article>

<style>
	/* Alternating float for inline images in the markdown prose */
	.prose-img :global(img) {
		width: auto;
		max-width: 45%;
		border-radius: 0.5rem;
		border: 1px solid #e5e7eb;
		margin-top: 0.25rem;
		margin-bottom: 1.5rem;
	}

	.prose-img :global(img:nth-of-type(odd)) {
		float: left;
		margin-right: 2rem;
		margin-left: 0;
	}

	.prose-img :global(img:nth-of-type(even)) {
		float: right;
		margin-left: 2rem;
		margin-right: 0;
	}

	/* Clear floats after the prose block */
	.prose-img::after {
		content: '';
		display: table;
		clear: both;
	}

	@media (max-width: 640px) {
		.prose-img :global(img) {
			float: none;
			width: 100%;
			margin-right: 0;
			margin-left: 0;
		}
	}

	.iframe-container--drum-machine {
		--drum-width: 1600px;
		--drum-height: 800px;
		--drum-scale: 0.28;
		height: calc(var(--drum-height) * var(--drum-scale));
		overflow: hidden;
	}

	.drum-machine-iframe {
		width: var(--drum-width);
		max-width: none;
		height: var(--drum-height);
		border: 0;
		transform: scale(var(--drum-scale));
		transform-origin: top left;
	}

	@media (min-width: 640px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.42;
		}
	}

	@media (min-width: 1024px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.58;
		}
	}

	@media (min-width: 1280px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.7;
		}
	}

	@media (min-width: 1536px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.82;
		}
	}
</style>
