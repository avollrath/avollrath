---
const {
	title,
	htmlText,
	projectImageSrc,
	transitionName,
	altProp,
	iframeSrc,
	iframeLayout,
	techStackLogos,
	buttonText
} = Astro.props
import { Image } from 'astro:assets'
import TechStack from '../components/TechStack.astro'
---

<div class="project-text-container z-10 col-span-3 flex flex-col xl:col-span-1 2xl:col-span-4">
	<div
		class="flex flex-col rounded-lg bg-white text-gray-400 shadow-lg max-md:rounded-md sm:text-base 3xl:text-lg"
	>
		<div class="p-6 sm:p-12">
			<h2
				class="long-transition mx-auto mb-4 w-fit rounded-lg border-2 border-solid border-magenta px-6 py-2 text-center font-header text-2xl text-magenta max-sm:mb-2 max-sm:text-base 3xl:text-lg"
			>
				{title}
			</h2>
			<p set:html={htmlText} class="text-xs sm:text-base" />
		</div>
		{
			techStackLogos && techStackLogos.length > 0 ? (
				<div class="mb-4 text-center">
					<span class="mb-8">Tech Stack:</span>
					<TechStack logos={techStackLogos} />
				</div>
			) : (
				<TechStack />
			)
		}
	</div>
</div>
<div
	class="project-image-container wrapper z-10 col-span-3 mb-4 flex flex-col items-center rounded-lg bg-white p-12 text-gray-400 shadow-lg max-md:rounded-md max-md:p-4 max-sm:border-none max-sm:p-0 sm:text-base xl:col-span-2 2xl:col-span-8 3xl:text-lg"
>
	<div
		class={`image-container relative rounded-md ${iframeSrc ? 'cursor-pointer iframe-trigger' : ''}`}
	>
		<Image
			src={projectImageSrc}
			transition:name={transitionName}
			alt={altProp}
			class="rounded-md"
			decoding="async"
			loading="lazy"
		/>
		{
			buttonText && (
				<button class="project-button absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-magenta px-4 py-2 text-xs font-semibold text-white shadow-lg sm:px-6 sm:py-3 sm:text-base lg:px-8 lg:py-4 lg:text-xl">
					{buttonText}
				</button>
			)
		}
	</div>
	{
		iframeSrc && (
			<div
				class={`iframe-container hidden w-full ${iframeLayout === 'drum-machine' ? 'iframe-container--drum-machine' : ''}`}
			>
				<iframe
					class={`w-full rounded-md ${iframeLayout === 'drum-machine' ? 'drum-machine-iframe' : 'aspect-video'}`}
					data-src={iframeSrc}
					allowfullscreen
					loading="lazy"
				/>
			</div>
		)
	}
</div>

<style>
	.iframe-container--drum-machine {
		--drum-width: 1600px;
		--drum-height: 800px;
		--drum-scale: 0.28;
		height: calc(var(--drum-height) * var(--drum-scale));
		overflow: hidden;
		border-radius: 0.375rem;
	}

	.drum-machine-iframe {
		width: var(--drum-width);
		max-width: none;
		height: var(--drum-height);
		border: 0;
		transform: scale(var(--drum-scale));
		transform-origin: top left;
	}

	@media (min-width: 640px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.42;
		}
	}

	@media (min-width: 1024px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.58;
		}
	}

	@media (min-width: 1280px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.7;
		}
	}

	@media (min-width: 1536px) {
		.iframe-container--drum-machine {
			--drum-scale: 0.82;
		}
	}
</style>
