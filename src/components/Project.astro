---
const {
	title,
	htmlText,
	projectImageSrc,
	transitionName,
	altProp,
	iframeSrc,
	techStackLogos,
	buttonText
} = Astro.props
import { Image } from 'astro:assets'
import TechStack from '../components/TechStack.astro'
---

<div class="project-text-container z-10 col-span-3 flex flex-col xl:col-span-1 2xl:col-span-4">
	<div
		class="flex flex-col rounded-lg bg-white text-gray-400 shadow-lg max-md:rounded-md sm:text-base 3xl:text-lg"
	>
		<div class="p-6 sm:p-12">
			<h2
				class="long-transition mx-auto mb-4 w-fit rounded-lg border-2 border-solid border-orange px-6 py-2 text-center font-header text-2xl text-orange max-sm:mb-2 max-sm:text-base 3xl:text-lg"
			>
				{title}
			</h2>
			<p set:html={htmlText} class="text-xs sm:text-base" />
		</div>
		{
			techStackLogos && techStackLogos.length > 0 ? (
				<div class="mb-4 text-center">
					<span class="mb-8">Tech Stack:</span>
					<TechStack logos={techStackLogos} />
				</div>
			) : (
				<TechStack />
			)
		}
	</div>
</div>
<div
	class="project-image-container wrapper z-10 col-span-3 mb-4 flex flex-col items-center rounded-lg bg-white p-12 text-gray-400 shadow-lg max-md:rounded-md max-md:p-4 max-sm:border-none max-sm:p-0 sm:text-base xl:col-span-2 2xl:col-span-8 3xl:text-lg"
>
	<div
		class={`image-container relative rounded-md ${iframeSrc ? 'cursor-pointer iframe-trigger' : ''}`}
	>
		<Image
			src={projectImageSrc}
			transition:name={transitionName}
			alt={altProp}
			class="rounded-md"
			decoding="async"
			loading="lazy"
		/>
		{
			buttonText && (
				<button class="project-button absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange px-8 py-4 text-xl font-semibold text-white shadow-lg hover:bg-orange/95">
					{buttonText}
				</button>
			)
		}
	</div>
	{
		iframeSrc && (
			<div class="iframe-container hidden w-full">
				<iframe
					class="aspect-video w-full rounded-md"
					data-src={iframeSrc}
					allowfullscreen
					loading="lazy"
				/>
			</div>
		)
	}
</div>
