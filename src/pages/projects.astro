---
import Layout from '../layouts/Layout.astro'
import jurassicJumpImg from '../images/projects/jurassic-jump.jpg'
import supervimusImg from '../images/projects/supervimus.jpg'
import pasiLunchImg from '../images/projects/pasilunch.jpg'
import janneImg from '../images/projects/janne.jpg'
import sushiImg from '../images/projects/sushi.jpg'
import taMobileImg from '../images/projects/ta-mobile.jpg'
import drumMachineImg from '../images/projects/drum-machine.jpg'
import ctcImg from '../images/projects/ctc.jpg'
import hypertypeImg from '../images/projects/hypertype.jpg'
import flipsiteImg from '../images/projects/flipsite.jpg'
import marathonImg from '../images/projects/marathon.jpg'
import Project from '../components/Project.astro'
---

<Layout
	title="Projects by André Vollrath"
	description="A collection of my frontend and game development projects."
	seo={{
		ogImage: pasiLunchImg,
		ogImageAlt: 'Projects page preview image',
		siteName: 'Andre Vollrath'
	}}
>
	<Project
		title="FlipSite - Inventory and Resale Tracker"
		htmlText={`
		<strong class='font-semibold text-dark-text'>FlipSite</strong> is a personal inventory and resale tracker I built to replace a spreadsheet that was getting hard to maintain.<br><br>

		It tracks what I own, what I paid, and where I bought it — with photos, receipts, and files attached per item so everything related to a purchase stays in one place. When I sell something, it calculates the actual profit, including across <strong class='font-semibold text-dark-text'>bundles</strong> where one purchase splits into multiple items sold separately.<br><br>

		The backend runs on <strong class='font-semibold text-dark-text'>Supabase</strong> for auth, file storage, and per-user data isolation. The frontend uses <strong class='font-semibold text-dark-text'>React</strong> and <strong class='font-semibold text-dark-text'>TanStack Query</strong> for data fetching, with a table view, photo gallery, dashboard analytics, and eight color themes with light and dark mode.<br><br>

		Check it out: <a class='font-semibold underline text-magenta' href='https://flipsite-three.vercel.app/'>FlipSite live app</a>
	`}
		projectImageSrc={flipsiteImg}
		altProp="FlipSite inventory and resale tracker"
		techStackLogos={['React.svg', 'TypeScript.svg', 'Tailwind.svg', 'Supabase.svg']}
	/>
	<Project
		title="Marathon Control Center"
		htmlText={`
		<strong class='font-semibold text-dark-text'>Marathon Control Center</strong> is a focused dashboard I built to manage the final <strong class='font-semibold text-dark-text'>21-day taper</strong> before my first marathon.<br><br>

		After a long break from consistent running — <strong class='font-semibold text-dark-text'>travel</strong>, <strong class='font-semibold text-dark-text'>winter</strong>, <strong class='font-semibold text-dark-text'>sickness</strong>, <strong class='font-semibold text-dark-text'>holidays</strong>, and life in general — I needed something more concrete than a training note or spreadsheet.<br><br>

		The app turns the last weeks into a clear system with <strong class='font-semibold text-dark-text'>runs</strong>, <strong class='font-semibold text-dark-text'>gym sessions</strong>, <strong class='font-semibold text-dark-text'>shoe testing</strong>, and <strong class='font-semibold text-dark-text'>actual kilometre tracking</strong> in one place.<br><br>

		It works like a compact <strong class='font-semibold text-dark-text'>habit tracker</strong> for a high-stakes training block, with persistent progress, backup/export, and optional <strong class='font-semibold text-dark-text'>Supabase sync</strong>.<br><br>

		The interface follows a <strong class='font-semibold text-dark-text'>dark, geometric, industrial</strong> design language with neon accent states, built with <strong class='font-semibold text-dark-text'>React</strong>, <strong class='font-semibold text-dark-text'>TypeScript</strong>, and <strong class='font-semibold text-dark-text'>Tailwind CSS</strong>.<br><br>

		View the app: <a class='font-semibold underline text-magenta' href='https://avollrath.github.io/marathon/'>Marathon Control Center</a>
	`}
		projectImageSrc={marathonImg}
		altProp="Marathon Control Center marathon training dashboard"
		techStackLogos={['React.svg', 'TypeScript.svg', 'Tailwind.svg', 'Supabase.svg']}
	/>

	<Project
		title="HyperType"
		buttonText="Play the game"
		htmlText={`
        <strong class='font-semibold text-dark-text'>HyperType</strong> is a neon arcade typing game I built to make practicing touch typing actually enjoyable.<br><br>
        I wanted something that feels fast, responsive, and satisfying, where every correct keypress has clear visual and audio feedback. The game turns typing into a simple combat loop, words come in, you type them, and they disappear in a burst of light and sound.<br><br>
        Along the way I explored <strong class='font-semibold text-dark-text'>game feel</strong>, <strong class='font-semibold text-dark-text'>timing and feedback</strong>, and how small details like sound effects, particles, and UI responsiveness can make a big difference.<br><br>
        The game includes multiple difficulty modes, achievements, and score tracking to make it something you can come back to and gradually improve at.<br><br>
        Try it here: <a class='font-semibold underline text-magenta' href='https://avollrath.github.io/HyperType/'>Play HyperType</a>
    `}
		projectImageSrc={hypertypeImg}
		altProp="HyperType neon arcade typing game"
		iframeSrc="https://avollrath.github.io/HyperType/"
		techStackLogos={['Godot.svg']}
	/>
	<Project
		title="CTC - Chess.com Trading Card"
		htmlText={`
		<strong class='font-semibold text-dark-text'>CTC - Chess.com Trading Card</strong> turns a Chess.com player profile into a collectible fantasy card.<br><br>

		The app fetches public player data from the <strong class='font-semibold text-dark-text'>Chess.com API</strong>, derives gameplay attributes like rarity, tactics, speed, and prestige, and generates a themed card identity including name, lore, and artwork.<br><br>

		The result is presented as an animated card with 3D tilt, shine effects, and download/share functionality. AI generation is used for card text and artwork, with deterministic fallbacks to ensure the card always renders cleanly.<br><br>

		Try it here: <a class='font-semibold underline text-magenta' href='https://chess-trading-card.vercel.app/'>CTC live demo</a>
	`}
		projectImageSrc={ctcImg}
		altProp="CTC Chess.com Trading Card app"
		techStackLogos={['Next.js.svg', 'TypeScript.svg', 'Tailwind.svg']}
	/>
	<Project
		title="PasiLunch"
		htmlText={`
	<strong class='font-semibold text-dark-text'>PasiLunch</strong> is a small web service and Slack integration that collects daily lunch menus from restaurants in Pasila, Helsinki.<br><br>

	Instead of checking multiple restaurant websites every day, it brings everything together in one place through a simple web interface and a Slack command.<br><br>

	Built with <strong class='font-semibold text-dark-text'>Node.js</strong>, <strong class='font-semibold text-dark-text'>Express</strong>, and <strong class='font-semibold text-dark-text'>Cheerio</strong>, the project scrapes menu data and uses the <strong class='font-semibold text-dark-text'>Gemini API</strong> to normalize different menu formats into one consistent structure.<br><br>

	Menus are cached and processed once per day to keep the data fresh while minimizing scraping and API usage. The Slack integration adds a bit of personality with randomized humorous messages.<br><br>

	Check out today's lunch options: <a class='font-semibold underline text-magenta' href='https://lunchbot-btnu.onrender.com/'>PasiLunch website</a>
`}
		projectImageSrc={pasiLunchImg}
		altProp="PasiLunch website"
		techStackLogos={[
			'HTML5.svg',
			'JavaScript.svg',
			'CSS 3.svg',
			'Node.js.svg',
			'Cheerio.svg',
			'Express.js.svg'
		]}
	/>

	<Project
		title="Jurassic Jump"
		buttonText="Click to load game"
		htmlText={`
			<strong class='font-semibold text-dark-text'>Jurassic Jump</strong> is a small jump-and-run game I built while exploring game development.<br><br>

			It started as an experiment in <strong class='font-semibold text-dark-text'>vanilla JavaScript</strong>, but as the project grew more complex I rebuilt it in the <strong class='font-semibold text-dark-text'>Godot engine</strong> using <strong class='font-semibold text-dark-text'>GDScript</strong>.<br><br>

			For the visuals I experimented with an AI-assisted workflow, creating reference images and turning them into a Claymation-inspired style with <strong class='font-semibold text-dark-text'>Affinity Photo</strong> and <strong class='font-semibold text-dark-text'>ComfyUI</strong>.<br><br>

			The project helped me explore <strong class='font-semibold text-dark-text'>level design</strong>, <strong class='font-semibold text-dark-text'>sprite sheets</strong>, <strong class='font-semibold text-dark-text'>particle systems</strong>, and <strong class='font-semibold text-dark-text'>game state management</strong>.<br><br>

			You can also play it in full screen: <a class='font-semibold underline text-magenta' href='https://avollrath.github.io/WebGL-test/'>here</a>
		  `}
		projectImageSrc={jurassicJumpImg}
		altProp="Jurassic Jump Game"
		iframeSrc="https://avollrath.github.io/jurassic-jump/"
		techStackLogos={['Godot.svg']}
	/>

	<Project
		title="TalentAdore Mobile App"
		htmlText={`
		<strong class='font-semibold text-dark-text'>TalentAdore Mobile App</strong> is a mobile interface concept I designed for TalentAdore’s recruitment platform.<br><br>

		The goal was to translate a complex SaaS product into a clear and intuitive mobile experience. I designed the interface from scratch and created an interactive prototype in <strong class='font-semibold text-dark-text'>Adobe XD</strong> to define navigation, flows, and screen interactions.<br><br>

		The prototype served as the foundation for development, and I later supported the engineering team to help keep the final product aligned with the original design vision.
	`}
		projectImageSrc={taMobileImg}
		altProp="TalentAdore Mobile App UI"
		techStackLogos={['Adobe XD.svg']}
	/>

	<Project
		title="Vollrath Drum Machine"
		htmlText={`
	<strong class='font-semibold text-dark-text'>Vollrath Drum Machine</strong> is a browser-based step sequencer inspired by classic hardware drum machines.<br><br>

	The interface features a <strong class='font-semibold text-dark-text'>16-step sequencer</strong>, five instrument channels, per-channel volume controls, playback speed settings, and preset patterns.<br><br>

	Built with <strong class='font-semibold text-dark-text'>pure JavaScript and CSS</strong>, the project explores sequencing logic, timing control, and browser-based audio playback without relying on frameworks.<br><br>

	Patterns can be saved with <strong class='font-semibold text-dark-text'>localStorage</strong>, while <strong class='font-semibold text-dark-text'>GSAP animations</strong> and custom CSS styling give the interface a tactile, hardware-inspired feel.<br><br>

	Try it out: <a class='font-semibold underline text-magenta' href='https://avollrath.github.io/drum-machine/'>Live Demo</a>
`}
		projectImageSrc={drumMachineImg}
		altProp="Vollrath Drum Machine browser sequencer"
		iframeSrc="https://avollrath.github.io/drum-machine/"
		iframeLayout="drum-machine"
		buttonText="Launch drum machine"
		techStackLogos={['HTML5.svg', 'JavaScript.svg', 'CSS 3.svg', 'GSAP.svg']}
	/>

	<Project
		title="Janne Heikkinen Website"
		htmlText={`
		The <strong class='font-semibold text-dark-text'>Janne Heikkinen Website</strong> was created for a Finnish member of parliament as part of a team of three.<br><br>

		I was responsible for the visual design of the site, shaping the layout, structure, and overall user experience. After the prototype was completed, I also joined the development phase and contributed to the frontend implementation.<br><br>

		The project gave me the chance to combine <strong class='font-semibold text-dark-text'>design ownership</strong> with hands-on <strong class='font-semibold text-dark-text'>frontend development</strong> in a real client project.<br><br>

		Visit the live site: <a class='font-semibold underline text-magenta' href='https://janneheikkinen.fi/'>janneheikkinen.fi</a>
	`}
		projectImageSrc={janneImg}
		altProp="Janne Heikkinen Website"
		techStackLogos={['React.svg', 'SASS.svg', 'JavaScript.svg', 'GraphQL.svg', 'Gatsby.svg']}
	/>

	<Project
		title="Sushi-san Website"
		htmlText={`
		The <strong class='font-semibold text-dark-text'>Sushi-san Website</strong> is a website I designed and developed for a sushi restaurant in Helsinki.<br><br>

		The goal was to create a clean online presence that reflects the restaurant’s brand while making key information easy to explore.<br><br>

		I handled both the <strong class='font-semibold text-dark-text'>visual design</strong> and the <strong class='font-semibold text-dark-text'>frontend implementation</strong>, building the site from scratch based on the restaurant’s logo and color palette.
	`}
		projectImageSrc={sushiImg}
		altProp="Sushi-san Website"
		techStackLogos={['HTML5.svg', 'CSS 3.svg']}
	/>

	<Project
		title="superVIMus"
		buttonText="Click to load game"
		htmlText={`
			<strong class='font-semibold text-dark-text'>superVIMus</strong> is a small puzzle game designed to build muscle memory for the <strong class='font-semibold text-dark-text'>hjkl</strong> movement keys used in Vim.<br><br>

			The game combines simple box-pushing mechanics with playful pixel graphics and a slightly absurd twist, making it a fun way to practice keyboard navigation.<br><br>

			Built with the <strong class='font-semibold text-dark-text'>Godot engine</strong> using <strong class='font-semibold text-dark-text'>GDScript</strong>, it explores <strong class='font-semibold text-dark-text'>grid-based movement</strong>, <strong class='font-semibold text-dark-text'>level design</strong>, and <strong class='font-semibold text-dark-text'>puzzle mechanics</strong>.<br><br>

			Try it out and sharpen your navigation skills: <a class='font-semibold underline text-magenta' href='https://avollrath.github.io/superVIMus/'>Play now</a>
		  `}
		projectImageSrc={supervimusImg}
		altProp="superVIMus Game"
		iframeSrc="https://avollrath.github.io/superVIMus/"
		techStackLogos={['Godot.svg']}
	/>
</Layout>
