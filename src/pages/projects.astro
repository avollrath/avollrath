---
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'

const allProjects = await getCollection('projects')
const projects = allProjects.sort(
	(a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
		(a.data.order ?? 99) - (b.data.order ?? 99)
)

const projectCategories = ['All', 'Apps', 'Games', 'Websites', 'Design'] as const
const projectsStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Projects by André Vollrath',
	description:
		'Frontend apps, design work, games, dashboards, and creative tools built by André Vollrath.',
	url: new URL('/projects/', Astro.site ?? Astro.url).toString(),
	itemListElement: projects.map((project, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		url: new URL(`/projects/${project.id}/`, Astro.site ?? Astro.url).toString(),
		name: project.data.title,
		description: project.data.summary
	}))
}
---

<Layout
	title="Projects by André Vollrath"
	description="Explore frontend apps, design work, games, dashboards, and creative tools built by André Vollrath with Astro, React, Godot, and JavaScript."
	seo={{
		siteName: 'André Vollrath',
		structuredData: [projectsStructuredData]
	}}
>
	<div class="projects-left-col col-span-3 flex flex-col gap-4 xl:col-span-1 2xl:col-span-3">
		<div
			class="projects-filter-bar flex flex-wrap justify-center gap-2 rounded-lg bg-white p-3 shadow-lg"
			aria-label="Project filters"
		>
			{
				projectCategories.map((category, index) => (
					<button
						type="button"
						class:list={[
							'project-filter rounded-full px-4 py-2 text-xs font-semibold transition',
							index === 0
								? 'is-active bg-magenta text-white shadow'
								: 'bg-gray-100 text-gray-500 hover:bg-magenta hover:text-white'
						]}
						data-filter={category}
					>
						{category}
					</button>
				))
			}
		</div>

		<div
			class="projects-text-container long-transition flex flex-col items-center rounded-md bg-about-gradient p-6 text-xs text-white shadow-lg sm:rounded-lg sm:p-12 sm:text-base 3xl:text-lg"
		>
			<h1
				class="long-transition mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-white px-8 py-3 font-header text-4xl tracking-wide"
			>
				Projects
			</h1>

			<p class="my-3 leading-relaxed">
				A collection of <strong class="font-semibold">web apps</strong>, games, websites, and design
				work I have built across frontend development, product design, and creative tooling.
			</p>

			<p class="my-3 leading-relaxed">
				This overview stays compact so the page can grow. Each card links to a dedicated project
				page with the fuller write-up, image, stack, and live demo links where available.
			</p>

			<p class="my-3 leading-relaxed">Use the filters to narrow the list by project type.</p>
		</div>
	</div>

	<div class="col-span-3 xl:col-span-2 2xl:col-span-9">
		<div class="project-grid grid gap-4 md:grid-cols-2 xl:grid-cols-3">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>

	<script>
		function initProjectFilters() {
			const filterBar = document.querySelector('.projects-filter-bar')
			const buttons = [...document.querySelectorAll('.project-filter')]
			const cards = [...document.querySelectorAll('.project-card')]
			if (!buttons.length) return

			function applyFilter(filter: string) {
				buttons.forEach((btn) => {
					const isActive = btn.getAttribute('data-filter') === filter
					btn.classList.toggle('is-active', isActive)
					btn.classList.toggle('bg-magenta', isActive)
					btn.classList.toggle('text-white', isActive)
					btn.classList.toggle('shadow', isActive)
					btn.classList.toggle('bg-gray-100', !isActive)
					btn.classList.toggle('text-gray-500', !isActive)
				})
				cards.forEach((card) => {
					const shouldShow = filter === 'All' || card.getAttribute('data-category') === filter
					card.classList.toggle('hidden', !shouldShow)
				})
			}

			// Restore filter from URL hash on navigation back
			const savedFilter = sessionStorage.getItem('projectFilter') || 'All'
			applyFilter(savedFilter)

			if (!filterBar || filterBar.dataset.projectFiltersBound === 'true') return

			filterBar.dataset.projectFiltersBound = 'true'
			filterBar.addEventListener('click', (event) => {
				const button = event.target instanceof Element ? event.target.closest('.project-filter') : null
				if (!button) return

				const filter = button.getAttribute('data-filter') || 'All'
				sessionStorage.setItem('projectFilter', filter)
				applyFilter(filter)
			})
		}

		const w = window as any
		if (!w.__projectFiltersInitialized) {
			document.addEventListener('astro:page-load', initProjectFilters)
			w.__projectFiltersInitialized = true
		}
		initProjectFilters()
	</script>
</Layout>
