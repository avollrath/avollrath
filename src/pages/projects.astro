---
import Layout from '../layouts/Layout.astro'
import Project from '../components/Project.astro'
import { projects } from '../data/projects'

const previewProject = projects[0]
---

<Layout
	title="Projects by AndrÃ© Vollrath"
	description="A collection of my frontend and game development projects."
	seo={{
		ogImage: previewProject.projectImageSrc,
		ogImageAlt: 'Projects page preview image',
		siteName: 'Andre Vollrath'
	}}
>
	{
		projects.map((project) => (
			<Project
				title={project.title}
				htmlText={project.htmlText}
				projectImageSrc={project.projectImageSrc}
				altProp={project.altProp}
				iframeSrc={project.iframeSrc}
				iframeLayout={project.iframeLayout}
				buttonText={project.buttonText}
				techStackLogos={project.techStackLogos}
			/>
		))
	}
</Layout>
