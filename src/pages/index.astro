---
import { getTopTracks } from '../scripts/getTopTracks.js'
import Layout from '../layouts/Layout.astro'
import Marquee from '../components/Marquee.astro'
import ClientLogoMarquee from '../components/ClientLogoMarquee.astro'
import ContactForm from '../components/ContactForm.astro'
import latestRenderImage from '../images/renders/grid-animation.mp4'
import latestRenderImageClay from '../images/renders/braunHF3-clay.jpg'
import profileImage from '../images/profile.png'
import eyeImage from '../images/eye.png'
import sunglassesImage from '../images/sunglasses.png'
import instagramLogo from '../images/icons/instagram.svg'
import spotifyLogo from '../images/icons/spotify.svg'
import linkedinLogo from '../images/icons/linkedin.svg'
import githubLogo from '../images/icons/github.svg'
import { Image } from 'astro:assets'
import { getResolvedPosts } from '../scripts/getResolvedPosts'

const refreshToken = import.meta.env.SPOTIFY_REFRESH_TOKEN

let topTracks = []
try {
	topTracks = await getTopTracks(refreshToken)
} catch (error) {
	console.error('Error fetching top tracks:', error)
}

const allPosts = await getResolvedPosts()

const latestPost = allPosts[0]
const latestRenderMediaSrc =
	typeof latestRenderImage === 'string' ? latestRenderImage : latestRenderImage?.src
const latestRenderIsVideo = /\.mp4($|\?)/i.test(latestRenderMediaSrc ?? '')
const latestRenderPosterSrc =
	typeof latestRenderImageClay === 'string' ? latestRenderImageClay : latestRenderImageClay?.src

const clientLogoModules = import.meta.glob('../images/client-logos/*.{png,jpg,jpeg,webp,svg}', {
	eager: true
})

const clientLogos = Object.entries(clientLogoModules).map(([filePath, mod]) => {
	const fileName = filePath.split('/').pop() || 'Client'
	const cleanName = fileName
		.replace(/\.[^/.]+$/, '')
		.replace(/-logo-?\d*$/i, '')
		.replace(/[-_]/g, ' ')
		.replace(/\b\w/g, (char) => char.toUpperCase())
	return {
		src: mod.default,
		alt: `${cleanName} logo`
	}
})
---

<Layout
	title="André Vollrath – Frontend Developer | React & UI Engineer"
	description="Experienced frontend developer crafting seamless and scalable web experiences. Specializing in modern UI development."
	seo={{
		ogImage: latestRenderImageClay,
		ogImageAlt: 'Latest render preview from Andre Vollrath portfolio',
		siteName: 'Andre Vollrath'
	}}
>
	<!-- Intro Section -->
	<div
		class="hero-container border-gradient relative z-10 flex flex-col items-center rounded-md bg-white px-4 py-8 shadow-lg sm:flex-row sm:rounded-lg sm:px-12 sm:py-24 xl:col-span-3 2xl:col-span-9"
	>
		<div class="z-10 flex-1">
			<div
				class="hero-badge mb-8 hidden w-auto rounded-full border-2 border-gray-200 bg-gray-100 px-3 py-1 lg:inline-block"
			>
				<span class="text-base text-gray-400">👋 vollrath.dev</span>
			</div>
			<p class="mb-6 text-center text-xs text-gray-400 sm:text-base lg:text-left 3xl:text-lg">
				UI/UX Designer | Front-End Developer
			</p>

			<h1
				class="hero-header text-gradient text-center font-header text-5xl sm:text-6xl md:mr-4 lg:text-left lg:text-8xl"
			>
				Hi, I’m André.
			</h1>

			<p
				class="intro-text z-10 my-4 max-w-screen-md rounded-xl bg-white/75 py-2 pr-2 text-xs backdrop-blur-sm backdrop-brightness-125 max-2xl:max-w-full sm:my-6 sm:text-left sm:text-2xl/relaxed 3xl:max-w-screen-lg 3xl:text-3xl/relaxed"
			>
				I’m a <strong class="font-semibold">designer who likes to build things</strong>. With a
				background in <strong class="font-semibold">visual design</strong> and
				<strong class="font-semibold">front-end development</strong>, I create
				<strong class="font-semibold">thoughtful digital products</strong> that turn complex systems
				into <strong class="font-semibold">clear and intuitive user experiences</strong>.
			</p>

			<div class="cta-button flex justify-center">
				<button
					type="button"
					class="contact-btn shimmer flex items-center rounded-full bg-magenta px-10 py-4 text-center font-semibold text-white transition duration-300 ease-[cubic-bezier(0.31,-0.105,0.43,2.4)] hover:scale-105 sm:text-3xl/relaxed"
				>
					Get in touch
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="float ml-2 h-6 w-6 stroke-white"
						fill="none"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="3"
							d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
					</svg>
				</button>
			</div>
		</div>
		<div class="avatar-wrapper max-lg:hidden" id="face">
			<Image
				src={profileImage}
				alt="André's Avatar"
				class="avatar-image"
				decoding="async"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="eye-container">
				<Image src={eyeImage} alt="Left Eye" class="eye-left" decoding="async" loading="lazy" />
				<Image src={eyeImage} alt="Right Eye" class="eye-right" decoding="async" loading="lazy" />
				<Image
					src={sunglassesImage}
					alt="sunglasses"
					class="sunglasses"
					decoding="async"
					loading="lazy"
				/>
			</div>
		</div>
	</div>

	<!-- Client logos marquee -->
	<div
		class="client-logos-container border-gradient h-full rounded-md bg-white py-6 shadow-lg sm:rounded-lg sm:py-8 xl:col-span-3 xl:row-start-2 2xl:col-span-12 2xl:row-start-2"
	>
		<h2
			class="mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
		>
			Worked with
		</h2>
		<ClientLogoMarquee logos={clientLogos} speed="32s" />
	</div>

	<!-- Now Section -->
	<div
		class="now-container border-gradient clickable-section flex h-full flex-col justify-between rounded-md bg-white px-4 py-8 text-xs shadow-lg sm:rounded-lg sm:p-12 sm:px-12 sm:text-base xl:col-span-1 xl:row-start-3 2xl:col-span-3 2xl:col-start-10 2xl:row-start-1"
	>
		<div class="now-content mb-6 flex items-center justify-between">
			<span class="arrow invisible"> </span>
			<h2
				class="long-transition rounded-lg border-2 border-solid border-dark-text px-8 py-3 font-header text-xl tracking-wide sm:text-4xl"
				transition:name="now-header"
			>
				Now
			</h2>
			<a href="/now" class="arrow-link">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6 stroke-dark-text"
					fill="none"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="3"
						d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>

		<ul
			class="bullets now-content mb-4 list-disc pl-5 text-xs text-gray-400 sm:text-base 3xl:text-lg"
		>
			<li class="mb-4 text-xs sm:text-base 3xl:text-lg">
				Studying the <strong class="font-semibold text-dark-text"
					>UX Design Institute Diploma</strong
				>
			</li>

			<li class="mb-4 text-xs sm:text-base 3xl:text-lg">
				Building <strong class="font-semibold text-dark-text"
					>mobile apps with React Native & Expo</strong
				>
			</li>

			<li class="mb-4 text-xs sm:text-base 3xl:text-lg">
				Training for my first <strong class="font-semibold text-dark-text">full marathon</strong> this
				spring
			</li>

			<li class="mb-4 text-xs sm:text-base 3xl:text-lg">
				Practicing <strong class="font-semibold text-dark-text">Rocket League</strong> and aiming for
				the Grand Champion rank
			</li>
		</ul>

		<p class="now-content text-center text-xs text-gray-400 sm:text-sm">
			Last Updated: March 8, 2026
		</p>
	</div>

	<!-- Latest Blog Section -->
	<div
		class="blog-container border-gradient clickable-section group h-full rounded-md bg-white px-4 py-8 shadow-lg sm:rounded-lg sm:p-12 sm:text-base xl:col-span-2 xl:col-start-2 xl:row-span-2 xl:row-start-3 2xl:col-span-3 2xl:row-start-3"
	>
		<div class="blog-content mb-6 flex items-center justify-between">
			<span class="arrow invisible"> </span>
			<h2
				class="long-transition rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
			>
				Blog
			</h2>
			<a href={latestPost.url} class="arrow-link">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6 stroke-dark-text"
					fill="none"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="3"
						d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>

		<div class="blog-content">
			<h3
				class="long-transition mb-6 text-center font-body text-xs font-semibold text-magenta sm:text-base 3xl:text-lg"
			>
				{latestPost.frontmatter.title}
			</h3>
			<div class="mb-6 w-full overflow-hidden rounded-md">
				<Image
					src={latestPost.frontmatter.image.src}
					alt={latestPost.frontmatter.image.alt}
					class="aspect-video w-full transform object-cover transition duration-1000 group-hover:scale-125"
					decoding="async"
					loading="lazy"
				/>
			</div>
			<p
				class="long-transition text-xs text-gray-400 sm:text-base 3xl:text-lg"
				set:html={latestPost.frontmatter.teaser}
			/>
			<div class="flex justify-center">
				<button
					class="mt-12 rounded-full bg-magenta px-10 py-4 text-lg font-semibold text-white transition-transform hover:scale-105"
					>Read blog post</button
				>
			</div>
		</div>
	</div>

	<!-- About Section -->
	<div
		class="about-container clickable-section bright-section h-full rounded-md bg-about-gradient px-4 py-8 text-xs text-white shadow-lg sm:rounded-lg sm:p-12 xl:col-span-1 xl:row-start-4 2xl:col-span-3 2xl:col-start-4 2xl:row-start-3"
	>
		<div class="about-content mb-6 flex items-center justify-between">
			<span class="arrow invisible"> </span>
			<h2
				class="long-transition rounded-lg border-2 border-solid border-white px-8 py-3 font-header text-xl tracking-wide sm:text-4xl"
				transition:name="about-header"
			>
				About
			</h2>
			<a href="/about" class="arrow-link white">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6 stroke-white"
					fill="none"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="3"
						d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
		<p class="about-content text-xs sm:text-base 3xl:text-lg">
			Hi, I'm <strong class="font-semibold">André Vollrath</strong>, a UI/UX designer and front-end
			developer based in Helsinki. With a background in digital and print media design and over ten
			years of experience working in agencies and SaaS teams, I focus on designing clear interfaces
			for digital products and bringing them to life in the browser.
		</p>
		<br />
		<p class="about-content text-xs sm:text-base 3xl:text-lg">
			I enjoy simplifying complex systems and turning them into intuitive user experiences. My work
			combines visual design, UX thinking, and front-end development, allowing me to collaborate
			closely with engineers and ensure that ideas translate smoothly from concept to working
			software.
		</p>
	</div>

	<!-- Latest Render Section -->
	<div
		class="render-container border-gradient clickable-section latest-render-section h-full rounded-md bg-white from-dark-card to-darker-card px-4 py-8 shadow-lg dark:bg-gradient-to-r sm:rounded-lg sm:p-12 xl:col-span-3 xl:row-start-5 2xl:col-span-6 2xl:col-start-7 2xl:row-start-3"
	>
		<div class="render-content mb-6 flex items-center justify-between">
			<span class="arrow invisible"> </span>
			<h2
				class="latest-render-header long-transition rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-left sm:text-4xl"
			>
				Latest render
			</h2>
			<a href="/renders" class="arrow-link">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6 stroke-dark-text"
					fill="none"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="3"
						d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
		<div class="latest-render-image image-container render-content rounded-md">
			{
				latestRenderIsVideo ? (
					<video
						data-video-src={latestRenderMediaSrc}
						transition:name="latest-render"
						class="js-lazy-render-video render-video rounded-md"
						autoplay
						muted
						loop
						playsinline
						controls
						preload="none"
						aria-label="Latest Render"
					/>
				) : (
					<>
						<Image
							src={latestRenderImage}
							alt="Latest Render"
							transition:name="latest-render"
							class="render-image rounded-md"
							densities={[1, 1.5, 2]}
							decoding="async"
							loading="lazy"
						/>
						<Image src={latestRenderImageClay} alt="Wireframe Render" class="wireframe-image" />
					</>
				)
			}
		</div>
	</div>

	<!-- Spotify Section -->
	<div
		class="spotify-container border-gradient flex h-full flex-col items-center overflow-visible rounded-md bg-white from-dark-card to-darker-card px-4 py-8 shadow-lg dark:bg-gradient-to-r sm:rounded-lg xl:col-span-2 xl:row-start-6 2xl:col-span-9 2xl:row-start-4"
	>
		<h2
			class="long-transition mb-8 rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
		>
			Spotify Top 10 <span
				class="whitespace-nowrap text-xs font-semibold tracking-normal text-gray-400 sm:text-2xl"
				>(last 6 months)</span
			>
		</h2>
		<div class="flex w-full flex-row flex-wrap justify-center gap-2">
			{
				topTracks.map((track) =>
					track && track.external_urls && track.album && track.album.images[0] ? (
						<div key={track.id} class="spotify-track">
							<a
								href={track.external_urls.spotify}
								target="_blank"
								rel="noopener noreferrer"
								title={`<strong class="font-semibold">${track.name}</strong> - ${track.artists.map((artist) => artist.name).join(', ')}`}
							>
								<img
									src={track.album.images[0].url}
									alt={`Cover art for ${track.name}`}
									class="h-auto w-24 rounded-md shadow-lg transition-transform duration-300 hover:scale-105 3xl:w-32"
								/>
							</a>
						</div>
					) : null
				)
			}
		</div>
	</div>

	<!-- Tech stack -->
	<div
		class="techstack-container border-gradient z-10 h-full overflow-hidden rounded-md bg-white from-dark-card to-darker-card pt-12 shadow-lg dark:bg-gradient-to-r sm:rounded-lg xl:col-span-3 xl:row-start-8 2xl:col-span-9 2xl:row-start-5"
	>
		<h2
			class="mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
		>
			Tech stack
		</h2>
		<Marquee
			words={[
				'UI/UX Design',
				'Figma',
				'React',
				'JavaScript',
				'HTML & CSS',
				'Tailwind',
				'LESS / SASS',
				'Astro',
				'GSAP',
				'Three.js',
				'Blender',
				'Design Systems',
				'Responsive Design',
				'Git'
			]}
		/>
	</div>

	<!-- Links Section -->
	<div
		class="links-container border-gradient flex h-full flex-col items-center rounded-md bg-white from-dark-card to-darker-card px-4 py-8 shadow-lg dark:bg-gradient-to-r sm:rounded-lg sm:p-12 xl:col-span-1 xl:col-start-3 xl:row-start-6 2xl:col-span-3 2xl:row-start-5"
	>
		<h2
			class="long-transition mb-4 rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
		>
			Links
		</h2>
		<div class="flex flex-1 items-center justify-center">
			<div class="grid grid-cols-2 gap-2">
				<a
					href="https://github.com/avollrath"
					target="_blank"
					rel="noopener noreferrer"
					title="GitHub"
				>
					<Image
						src={githubLogo}
						alt="Github Logo"
						class="h-auto w-24 rounded-md transition-transform duration-300 hover:scale-105 3xl:w-32"
						decoding="async"
						loading="lazy"
					/>
				</a>
				<a
					href="https://www.instagram.com/charliefeatherlight/"
					target="_blank"
					rel="noopener noreferrer"
					title="Instagram"
				>
					<Image
						src={instagramLogo}
						alt="Instagram Logo"
						class="h-auto w-24 rounded-md transition-transform duration-300 hover:scale-105 3xl:w-32"
						decoding="async"
						loading="lazy"
					/>
				</a>
				<a
					href="https://www.linkedin.com/in/andrevollrath/"
					target="_blank"
					rel="noopener noreferrer"
					title="LinkedIn"
				>
					<Image
						src={linkedinLogo}
						alt="LinkedIn Logo"
						class="h-auto w-24 rounded-md transition-transform duration-300 hover:scale-105 3xl:w-32"
						decoding="async"
						loading="lazy"
					/>
				</a>
				<a
					href="https://open.spotify.com/playlist/2mEjYAIsPROQQiFILs4NkX?si=f922c39bcdf24878"
					target="_blank"
					rel="noopener noreferrer"
					title="Spotify"
				>
					<Image
						src={spotifyLogo}
						alt="Spotify Logo"
						class="h-auto w-24 rounded-md transition-transform duration-300 hover:scale-105 3xl:w-32"
						decoding="async"
						loading="lazy"
					/>
				</a>
			</div>
		</div>
	</div>

	<!-- Contact Section -->
	<div
		class="contact-container border-gradient z-10 flex h-full flex-col justify-center rounded-md bg-white px-4 py-8 shadow-lg dark:bg-gradient-to-r sm:rounded-lg sm:p-12 xl:col-span-1 xl:col-start-3 xl:row-start-7 2xl:col-span-4 2xl:col-start-1 2xl:row-start-6"
	>
		<h2
			class="long-transition mx-auto mb-6 w-fit rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide sm:text-4xl"
		>
			Get in touch
		</h2>
		<div id="contact" class="flex flex-1 items-center justify-center">
			<ContactForm />
		</div>
	</div>

	<!-- Based in Section -->
	<div
		class="based-in-container border-gradient z-10 flex h-full flex-col items-center rounded-md bg-white px-4 py-8 shadow-lg dark:bg-gradient-to-r sm:rounded-lg sm:p-12 xl:col-span-2 xl:col-start-1 xl:row-start-7 2xl:col-span-8 2xl:row-start-6"
	>
		<h2
			class="long-transition mb-12 rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl sm:text-4xl"
		>
			Based in
		</h2>
		<div class="flex flex-col items-center justify-center xl:flex-row 2xl:flex-row">
			<!-- <img
				src={`basedin.svg`}
				alt="Globe"
				class="mb-12 mr-0 h-auto w-72 invert-[.5] md:py-12 xl:mr-12 2xl:w-96"
			/> -->
			<div class="mb-12 mr-0 h-auto w-72 opacity-60 xl:mb-0 xl:mr-12 2xl:w-96">
				<lottie-player
					src="https://lottie.host/e08917be-738c-4d39-b834-a4302a5a93c0/5zKSJTrRJ7.json"
					background="#FFFFFF"
					speed="1"
					style="width: 100%; height: 100%"
					loop
					autoplay
					direction="1"
					mode="normal"
					id="lottie-player"></lottie-player>
			</div>
			<div class="grid grid-flow-row gap-2">
				<h1
					class="based-in-text text-center font-header text-5xl sm:text-8xl lg:text-left 2xl:text-9xl"
				>
					Helsinki<br />Finland<br /><span class="text-gray-400">GMT +2</span>
				</h1>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { initializeHomeInteractions } from '../scripts/homeInteractions.js'

	initializeHomeInteractions()
</script>

<style>
	.render-container {
		position: relative;
	}

	.image-container {
		position: relative;
	}

	.render-image,
	.render-video,
	.wireframe-image {
		max-width: 100%;
		transition: 0.5s ease-in-out;
	}

	.render-video {
		display: block;
	}

	.wireframe-image {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
	}

	.image-container:hover .wireframe-image {
		opacity: 1;
		transform: scale(1.1);
	}

	@keyframes fadeInOut {
		0%,
		50% {
			opacity: 0;
		}
		25%,
		75% {
			opacity: 1;
		}
	}

	@media (hover: none) {
		.wireframe-image {
			animation: fadeInOut 10s infinite ease-in-out;
		}
	}
</style>
