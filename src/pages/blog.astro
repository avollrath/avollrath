---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import { getResolvedPosts } from '../scripts/getResolvedPosts'
const allPosts = await getResolvedPosts()
const latestPost = allPosts[0]
---

<Layout
	title="Blog by André Vollrath"
	description="Thoughts on design, frontend development, creative projects, and the things I'm currently exploring."
	seo={{
		ogImage: latestPost?.frontmatter?.image?.src ?? '/about2.jpg',
		ogImageAlt: latestPost?.frontmatter?.image?.alt ?? 'Blog page preview image',
		siteName: 'André Vollrath'
	}}
>
	<div class="blog-text-container col-span-3 flex flex-col xl:col-span-1 2xl:col-span-3">
		<div
			class="long-transition flex flex-col items-center rounded-md bg-about-gradient p-6 text-xs text-white shadow-lg sm:rounded-lg sm:p-12 sm:text-base 3xl:text-lg"
		>
			<h1
				class="long-transition mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-white px-8 py-3 font-header text-4xl tracking-wide"
				transition:name="blog-header"
			>
				Blog
			</h1>

			<p class="my-3 leading-relaxed">
				Welcome to my <strong class="font-semibold">blog</strong>, a place where I write about the
				things I’m building, learning, and figuring out along the way.
			</p>

			<p class="my-3 leading-relaxed">
				Most posts revolve around <strong class="font-semibold">frontend development</strong>,
				<strong class="font-semibold">design</strong>, creative side projects, and the occasional
				technical rabbit hole that feels too interesting not to document.
			</p>

			<p class="my-3 leading-relaxed">
				Some entries are practical write-ups, others are more like project journals, notes from
				experiments, or things I wish I had found in one place when I started.
			</p>

			<p class="my-3 leading-relaxed">
				If any of it helps, inspires, or simply makes you curious to try something yourself, even
				better.
			</p>
		</div>
	</div>

	<div class="col-span-3 xl:col-span-2 2xl:col-span-9">
		{
			allPosts.map((post) => (
				<div class="blog-post-container border-gradient group mb-4 block cursor-pointer rounded-md bg-white shadow-xl hover:shadow-2xl sm:rounded-lg">
					<a
						href={post.url}
						class="flex items-stretch overflow-hidden rounded-t-md sm:rounded-t-lg md:rounded-l-lg"
					>
						<div class="w-full max-w-7xl flex-1 overflow-hidden">
							{post.frontmatter.image.src ? (
								<Image
									src={post.frontmatter.image.src}
									alt={post.frontmatter.image.alt || 'Default Alt Text'}
									class="h-full w-full transform object-cover transition duration-500 ease-out group-hover:scale-110"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<p>No image available</p>
							)}
						</div>

						<div class="flex w-full flex-1 flex-col items-center justify-center p-6 sm:p-12">
							<div>
								<h2 class="md:text-md mb-4 origin-bottom-left font-header text-sm tracking-wide transition duration-500 ease-in-out group-hover:-translate-y-2 group-hover:text-magenta lg:text-lg xl:text-xl 2xl:text-2xl">
									{post.frontmatter.title}
								</h2>
								<p class="text-xs text-gray-400 lg:text-base">{post.frontmatter.description}</p>
							</div>
						</div>
					</a>
				</div>
			))
		}
	</div>
</Layout>
