---
import Layout from '../../layouts/Layout.astro'
import Project from '../../components/Project.astro'
import { projects } from '../../data/projects'

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project }
	}))
}

const { project } = Astro.props
---

<Layout
	title={`${project.title} by AndrÃ© Vollrath`}
	description={project.summary}
	seo={{
		ogImage: project.projectImageSrc,
		ogImageAlt: project.altProp,
		siteName: 'Andre Vollrath'
	}}
>
	<div class="col-span-3 2xl:col-span-12">
		<a
			href="/projects"
			class="mb-4 inline-flex rounded-full bg-white px-4 py-2 text-xs font-semibold text-magenta shadow transition hover:-translate-y-0.5 hover:shadow-md"
		>
			Back to projects
		</a>
	</div>

	<Project
		title={project.title}
		htmlText={project.htmlText}
		projectImageSrc={project.projectImageSrc}
		altProp={project.altProp}
		iframeSrc={project.iframeSrc}
		iframeLayout={project.iframeLayout}
		buttonText={project.buttonText}
		techStackLogos={project.techStackLogos}
	/>
</Layout>
