---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Project from '../../components/Project.astro'

export async function getStaticPaths() {
	const projects = await getCollection('projects')
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project }
	}))
}

const { project } = Astro.props
const { Content } = await render(project)
const projectUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString()
const projectImageUrl = new URL(project.data.heroImage.src, Astro.site ?? Astro.url).toString()
const pageTitle = project.data.seoTitle ?? `${project.data.title} by André Vollrath`
const projectStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.data.title,
	description: project.data.summary,
	url: projectUrl,
	image: projectImageUrl,
	creator: {
		'@type': 'Person',
		name: 'André Vollrath',
		url: new URL('/', Astro.site ?? Astro.url).toString()
	},
	about: project.data.category,
	keywords: project.data.techStackLogos
		.map((logo) => logo.replace(/\.svg$/i, '').replace(/-/g, ' '))
		.join(', ')
}
---

<Layout
	title={pageTitle}
	description={project.data.summary}
	seo={{
		ogImage: project.data.heroImage,
		ogImageAlt: project.data.heroImageAlt,
		siteName: 'André Vollrath',
		structuredData: [projectStructuredData]
	}}
>
	<div class="project-detail-breadcrumb col-span-3 flex justify-center py-3 2xl:col-span-12">
		<nav class="flex items-center gap-2 text-xs text-gray-400">
			<a href="/projects" class="transition-colors hover:text-magenta">Projects</a>
			<span>›</span>
			<span class="text-gray-600">{project.data.title}</span>
		</nav>
	</div>

	<Project project={project.data} slug={project.id}>
		<Content />
	</Project>
</Layout>
