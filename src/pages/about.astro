---
import Layout from '../layouts/Layout.astro'
import FavoriteBooks from '../components/FavoriteBooks.astro'
import TechStack from '../components/TechStack.astro'
import { Image } from 'astro:assets'
import aboutImage from '../images/about2.jpg'
---

<Layout
	title="About André Vollrath"
	description="Frontend developer passionate about great user experiences."
	seo={{
		ogImage: aboutImage,
		ogImageAlt: 'Portrait themed preview of the About page',
		siteName: 'André Vollrath'
	}}
>
	<div
		class="about-image border-gradient relative col-span-1 hidden overflow-hidden rounded-lg from-dark-card to-darker-card shadow-lg dark:bg-gradient-to-r xl:col-span-1 xl:flex 2xl:col-span-4"
	>
		<Image
			src={aboutImage}
			alt=""
			class="h-full w-full object-cover"
			loading="lazy"
			decoding="async"
			format="avif"
		/>
	</div>
	<div
		class="long-transition border-gradient col-span-3 flex flex-col items-center rounded-md bg-white px-4 py-8 text-xs text-gray-400 shadow-lg sm:rounded-lg sm:p-12 sm:text-base xl:col-span-2 2xl:col-span-8 3xl:text-lg"
	>
		<div class="bio items-center space-y-4">
			<h1
				class="long-transition mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-dark-text px-8 py-3 text-center font-header text-xl tracking-wide text-dark-text sm:text-4xl"
				transition:name="about-header"
			>
				About Me
			</h1>

			<p>
				Hello, I'm <strong class="font-semibold text-dark-text">André</strong>, a UI/UX designer and
				front-end developer based in Helsinki. My interest in technology started early in the 90s
				with a <strong class="font-semibold text-dark-text">Commodore 64</strong>, where I spent
				more time trying to beat 8-bit games than doing my homework.
			</p>

			<p>
				That curiosity eventually turned into a career in
				<strong class="font-semibold text-dark-text">design</strong> and
				<strong class="font-semibold text-dark-text">web development</strong>. With a background in
				Digital and Print Media Design, I now focus on creating clear, intuitive interfaces for
				digital products and bringing them to life in the browser.
			</p>

			<p>
				Over the years I’ve worked in agencies and SaaS teams across Germany and Finland, designing
				user interfaces and collaborating closely with engineers to turn ideas into real products.
				Currently I work at
				<a
					href="https://talentadore.com"
					class="font-semibold text-magenta underline"
					target="_blank"
					rel="noopener noreferrer">TalentAdore</a
				>, where I design and implement interfaces for a recruitment SaaS platform used by
				international customers.
			</p>

			<p>
				I enjoy simplifying complex systems and turning them into intuitive user experiences. My
				work sits at the intersection of visual design, UX thinking, and front-end development.
			</p>

			<div class="p-2 sm:p-6">
				<h3
					class="mx-auto mb-8 w-fit rounded-lg border-2 border-solid border-magenta px-6 py-2 text-center text-xl font-semibold text-magenta"
				>
					My toolbox
				</h3>
				<TechStack excludeLogos={['Adobe XD.svg']} />
			</div>

			<p>
				Outside of work I enjoy exploring creative technologies like
				<strong class="font-semibold text-dark-text">Three.js</strong>,
				<strong class="font-semibold text-dark-text">Blender</strong>, and interactive web graphics.
			</p>

			<p>
				When I'm not designing or coding you'll probably find me learning chess, playing piano,
				doing sports, or playing Rocket League.
			</p>

			<p>
				My <a href="/blog" class="font-semibold text-magenta underline">blog</a>
				is where I occasionally share projects, experiments, and things I’ve learned along the way.
			</p>

			<p>If you'd like to collaborate or just say hello, feel free to get in touch.</p>

			<p>
				Best,<br /><br />
				<strong class="font-semibold text-dark-text">André 😎🤙</strong>
			</p>
		</div>
	</div>

	<FavoriteBooks bookWidth="w-20" />
</Layout>
